# InvokeHoneyBadger .gitignore

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.vim/
*.sublime-project
*.sublime-workspace

# Environment Files (NEVER commit credentials)
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
*.pfx
credentials.json
secrets.json
config.secret.*

# Build Output
dist/
build/
out/
.cache/
.temp/
.tmp/

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Logs
logs/
*.log
log.txt

# Backup Files
*.bak
*.backup
*-backup
*.orig

# Testing
coverage/
.nyc_output/
test-results/
*.test.cache

# Security & Sensitive Data
*.crt
*.csr
*.der
*.cer
*.cert
private-key*
auth-token*
api-key*

# Temporary Files
*.tmp
*.cache
.sass-cache/
